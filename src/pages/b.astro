---
import Seite from '../layouts/Seite.astro'
import Kopf from '../components/Kopf.astro'
import Achsen from '../components/Achsen.astro'
import Dekodierer from '../components/Dekodierer.astro'
import Felder from '../components/Felder.astro'
import Ablauf from '../components/Ablauf.astro'
import Schluss from '../components/Schluss.astro'
import { AUSSAGE, MOTTO, WOFUER, PERSON, STATIONEN, TITEL } from '../data/inhalt'
import '../styles/b.css'
---
<Seite klasse="v-b">
  <Kopf />
  <main id="inhalt" tabindex="-1">
    <section class="dunkelkammer" data-ton="dunkel" data-dunkelkammer>
      <div class="dunkelkammer-innen">
        <div class="abzug" aria-hidden="true" data-abzug>
          <img src="/sebastian.jpg" alt="" width="1344" height="2016" fetchpriority="high" />
        </div>
        <h1 class="belichtet" data-belichtet>
          <span class="belichtet-gross">wahrnehmung</span>
          <span class="belichtet-klein">gestalten.</span>
        </h1>
        <div class="dunkelkammer-unter" data-unter>
          <p>{MOTTO}</p>
          <p class="leise">{WOFUER}</p>
        </div>
      </div>
    </section>

    <section class="raum innen" data-ton="dunkel" aria-label="Haltung">
      <p class="raum-text" data-zeilen>{AUSSAGE}</p>
    </section>

    <Achsen ton="dunkel" />
    <Dekodierer />
    <Felder />
    <Ablauf />

    <section class="platte" data-ton="dunkel" aria-labelledby="k-person">
      <div class="platte-bild" data-platte>
        <img src="/sebastian.jpg" alt="Sebastian Knust" width="1344" height="2016" loading="lazy" />
      </div>
      <div class="platte-text innen">
        <h2 id="k-person" class="abschnitt-titel">{TITEL.person}</h2>
        <p class="person-eins">{PERSON[0]}</p>
        <div class="platte-spalten">
          <div class="person-text">{PERSON.slice(1).map((p) => <p>{p}</p>)}</div>
          <ol class="stationen">{STATIONEN.map(([jahr, was]) => <li><span>{jahr}</span>{was}</li>)}</ol>
        </div>
      </div>
    </section>

    <Schluss />
  </main>
  <script>
    import { start } from '../scripts/b'
    start()
  </script>
</Seite>
