---
// Auswahl: drei Varianten derselben Seite zum Vergleichen.
// Nach der Entscheidung ersetzt die gewählte Variante diese Seite.
import Seite from '../layouts/Seite.astro'
import Kopf from '../components/Kopf.astro'
import '../styles/auswahl.css'

const VARIANTEN = [
  { pfad: '/a/', name: 'schärfe', zeile: 'Die Worte beginnen unscharf, wie ein erster Eindruck. Eine Linse am Zeiger und das Scrollen stellen sie scharf. Danach führen sieben Wörter vor, wofür sie stehen.', technik: 'Live gerendert in WebGL, sieben Achsen als Scroll-Bühne', ton: 'Schwarz mit weißen Kapiteln' },
  { pfad: '/b/', name: 'belichtung', zeile: 'Ihr Bild entwickelt sich beim Scrollen wie in der Dunkelkammer. Die sieben Fragen laufen als Filmstreifen vorbei, jedes Bild wird belichtet, sobald es die Mitte erreicht.', technik: 'Fotografie als Hauptmotiv, bereit für eigene Filme', ton: 'Dunkel, ein heller Moment' },
  { pfad: '/c/', name: 'raster', zeile: 'Reine Typografie auf Weiß. Die Schrift wird dort laut, wo der Zeiger ist. Die sieben Fragen stehen als Index, und jede Zeile wird beim Lesen auf ihre eigene Weise laut.', technik: 'Ohne WebGL, am schnellsten, Schweizer Raster', ton: 'Weiß mit schwarzem Schluss' },
]
---
<Seite titel="Auswahl | kommunikations.studio" klasse="v-auswahl" ton="hell">
  <Kopf ziel="/a/" zielText="erste variante" />
  <main id="inhalt" class="auswahl innen" tabindex="-1">
    <h1 class="auswahl-titel">drei wege zur selben wirkung.</h1>
    <p class="auswahl-einleitung">Alle drei Varianten tragen dieselben Inhalte, dieselbe Schrift und dieselben Farben. Sie unterscheiden sich in Haltung, Bewegung und Bild. Am besten auf einem Rechner mit Maus ansehen, danach auf dem Handy.</p>
    <ol class="auswahl-liste">
      {VARIANTEN.map((v, i) => (
        <li>
          <a class="variante" href={v.pfad}>
            <span class="variante-zahl" aria-hidden="true">{String.fromCharCode(97 + i)}</span>
            <span class="variante-name">{v.name}</span>
            <span class="variante-zeile">{v.zeile}</span>
            <span class="variante-fakten"><span>{v.technik}</span><span>{v.ton}</span></span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Seite>
