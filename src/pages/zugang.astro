---
// Eingang für Sebastian, solange die Website gesperrt ist. Das Formular schickt
// das Passwort an die Middleware; sie setzt bei Erfolg ein Cookie.
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Zugang · kommunikations.studio</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      @font-face { font-family: 'Archivo'; src: url('/fonts/archivo.woff2') format('woff2'); font-weight: 100 900; font-stretch: 62% 125%; }
      * { box-sizing: border-box; margin: 0; }
      html, body { height: 100%; background: #000; color: #fff; color-scheme: dark; }
      body { font-family: 'Archivo', system-ui, sans-serif; display: grid; place-items: center; padding: 20px; }
      form { width: min(100%, 360px); display: grid; gap: 18px; }
      h1 { font-weight: 800; font-stretch: 112%; font-size: 40px; letter-spacing: -0.03em; text-transform: lowercase; }
      label { font-size: 14px; color: #8b8b88; }
      input { font: inherit; font-size: 18px; color: #fff; background: transparent; border: 0; border-bottom: 2px solid #fff; padding: 10px 0; width: 100%; outline: none; }
      input:focus { border-bottom-width: 4px; }
      button { font: inherit; font-weight: 700; font-size: 16px; color: #000; background: #fff; border: 0; padding: 14px 18px; cursor: pointer; }
      .fehler { color: #fff; font-size: 14px; display: none; }
      .fehler.an { display: block; }
    </style>
  </head>
  <body>
    <form method="post" action="/zugang/">
      <h1>zugang.</h1>
      <label for="passwort">Passwort</label>
      <input id="passwort" name="passwort" type="password" autocomplete="current-password" required autofocus />
      <p class="fehler" data-fehler>Falsches Passwort. Bitte erneut eingeben.</p>
      <button type="submit">Eintreten</button>
    </form>
    <script>
      if (location.search.includes('falsch')) document.querySelector('[data-fehler]')?.classList.add('an')
    </script>
  </body>
</html>
