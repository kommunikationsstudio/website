---
import { PERSON, STATIONEN, TITEL } from '../data/inhalt'
import Portraet from './Portraet.astro'
interface Props { ton?: 'dunkel' | 'hell' }
const { ton = 'hell' } = Astro.props
---
<section class="person innen" data-ton={ton} aria-labelledby="k-person">
  <h2 id="k-person" class="abschnitt-titel">{TITEL.person}</h2>
  <div class="person-raster">
    <figure class="portrait" data-portrait>
      <Portraet alt="Sebastian Knust" sizes="(min-width: 900px) 40vw, 100vw" />
      <figcaption>Sebastian Knust, Limburg an der Lahn</figcaption>
    </figure>
    <div class="person-text">
      <p class="person-eins">{PERSON[0]}</p>
      {PERSON.slice(1).map((p) => <p>{p}</p>)}
      <ol class="stationen">
        {STATIONEN.map(([jahr, wo, was]) => <li data-zeile><span class="station-jahr">{jahr}</span><div><strong>{wo}</strong><p>{was}</p></div></li>)}
      </ol>
    </div>
  </div>
</section>
