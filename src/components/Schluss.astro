---
import { MAIL, SCHLUSS, TEL, TEL_ANZEIGE, TERMINE } from '../data/inhalt'
import { ARBEITEN_FERTIG } from '../data/arbeiten'
interface Props { ton?: 'dunkel' | 'hell' }
const { ton = 'dunkel' } = Astro.props
---
<section id="gespraech" class="schluss innen" data-ton={ton} aria-labelledby="k-gespraech" tabindex="-1">
  <h2 id="k-gespraech" class="schluss-titel">{SCHLUSS.titel}</h2>
  <div class="schluss-text">
    <p>{SCHLUSS.text}</p>
    <div class="knoepfe" role="group" aria-label="Erstgespräch vereinbaren">
      {TERMINE.map((t) => (
        <a class="knopf" href={t.link} {...(t.extern ? { target: '_blank', rel: 'noopener' } : {})}><span>{t.titel}</span><span class="knopf-zusatz">{t.zusatz}</span></a>
      ))}
    </div>
    <p class="adresse">oder per E-Mail an <a href={`mailto:${MAIL}`}>{MAIL}</a>, telefonisch unter <a href={`tel:${TEL}`}>{TEL_ANZEIGE}</a></p>
  </div>
</section>
<footer class="fuss innen" data-ton={ton}>
  <span>kommunikations.studio, Sebastian Knust, Limburg an der Lahn</span>
  <nav aria-label="Weitere Seiten">{ARBEITEN_FERTIG && <a href="/arbeiten/">Arbeiten</a>}<a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></nav>
</footer>
