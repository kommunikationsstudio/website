---
import { KATEGORIEN, TITEL } from '../data/inhalt'
import Portraet from './Portraet.astro'
interface Props { ton?: 'dunkel' | 'hell' }
const { ton = 'hell' } = Astro.props
---
<section class="achsen" data-ton={ton} data-achsen aria-labelledby="k-achsen">
  <div class="achsen-buehne">
    <h2 id="k-achsen" class="achsen-kopf innen">{TITEL.achsen}</h2>
    <div class="achsen-stapel">
      {KATEGORIEN.map((k, i) => (
        <article class="achse innen" data-achse={i} data-art={k.art}>
          <h3 class="achse-wort"><span class="sr-only">{k.kat}</span>{[...k.kat.toLowerCase()].map((b) => <span class="b" aria-hidden="true">{b}</span>)}</h3>
          {k.art === 'bildsprache' && <div class="achse-bild" aria-hidden="true"><Portraet sizes="(min-width: 900px) 50vw, 100vw" /></div>}
          <div class="achse-text">
            <p class="achse-frage">{k.frage}</p>
            <p class="achse-statt">statt <s>{k.wort}</s></p>
          </div>
        </article>
      ))}
    </div>
    <div class="achsen-fortschritt innen" aria-hidden="true"><span data-achsen-balken></span></div>
  </div>
</section>
