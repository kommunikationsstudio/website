---
import { BEISPIEL, TITEL } from '../data/inhalt'
interface Props { ton?: 'dunkel' | 'hell' }
const { ton = 'hell' } = Astro.props
const [anlass, vorher, ziel, spannung] = BEISPIEL.dekodierung.map(([, v]) => v)
---
<section class="beispiel innen" data-ton={ton} aria-labelledby="k-beispiel">
  <h2 id="k-beispiel" class="abschnitt-titel">{TITEL.beispiel}</h2>
  <div class="beispiel-raster">
    <div class="beispiel-auftrag">
      <p class="deko-wer">Briefing, {BEISPIEL.kopf}</p>
      <p class="beispiel-spannung" data-zeile>{spannung}</p>
      <p data-zeile>{anlass} {vorher} {ziel}</p>
      <p class="beispiel-hinweis" data-zeile>Diese Website ist selbst ein Projekt. Jedes Projekt beginnt mit so einer Analyse.</p>
    </div>
    <dl class="beispiel-entscheidungen">
      {BEISPIEL.hypothesen.map(([k, v]) => <div data-zeile><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </div>
</section>
