---
import '../styles/basis.css'

interface Props {
  titel?: string
  beschreibung?: string
  klasse?: string
  ton?: 'dunkel' | 'hell'
}

const {
  titel = 'Positionierung und Corporate Design in Limburg | kommunikations.studio',
  beschreibung = 'Positionierung, Erscheinungsbild und Inhalte für Unternehmen in Rhein-Main und Mittelhessen. Sebastian Knust, Limburg. Das Erstgespräch ist kostenfrei.',
  klasse = '',
  ton = 'dunkel',
} = Astro.props
const STUDIO_TEXT = 'Studio für Positionierung, Erscheinungsbild und Inhalte von Sebastian Knust in Limburg an der Lahn. Übersetzt vage Briefing-Wünsche in konkrete Entscheidungen über Schrift, Bild, Sprache und Bewegung.'

// Bis zur Freigabe bleibt die Seite aus den Suchmaschinen heraus.
const freigegeben = import.meta.env.PUBLIC_FREIGEGEBEN === 'true'
const kanonisch = new URL(Astro.url.pathname, Astro.site)

const STUDIO = 'https://www.kommunikations.studio/#studio'
const PERSON = 'https://www.kommunikations.studio/#sebastian'
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': STUDIO,
      name: 'kommunikations.studio',
      url: 'https://www.kommunikations.studio',
      logo: 'https://www.kommunikations.studio/logo-ks-master.svg',
      image: 'https://www.kommunikations.studio/og.png',
      slogan: 'Wahrnehmung gestalten. Vom Eindruck zur Wirkung.',
      description: STUDIO_TEXT,
      email: 'kontakt@kommunikations.studio',
      telephone: '+49 156 78540600',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Felizitas-Massenkeil-Str. 9',
        postalCode: '65549',
        addressLocality: 'Limburg an der Lahn',
        addressRegion: 'Hessen',
        addressCountry: 'DE',
      },
      areaServed: ['Rhein-Main', 'Mittelhessen', 'Hessen'].map((name) => ({ '@type': 'Place', name })),
      knowsAbout: ['Positionierung', 'Corporate Design', 'Webdesign', 'Markenkommunikation', 'Employer Branding', 'Interne Kommunikation', 'Wahrnehmungsanalyse'],
      founder: { '@id': PERSON },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Leistungen',
        itemListElement: ['Positionierung', 'Erscheinungsbild', 'Inhalte'].map((name) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name },
        })),
      },
    },
    {
      '@type': 'Person',
      '@id': PERSON,
      name: 'Sebastian Knust',
      jobTitle: 'Gestalter für Positionierung und Erscheinungsbild',
      knowsAbout: ['Corporate Design', 'Markenkommunikation', 'Fotografie', 'Video', 'Webentwicklung'],
      image: 'https://www.kommunikations.studio/sebastian.jpg',
      worksFor: { '@id': STUDIO },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.kommunikations.studio/#website',
      name: 'kommunikations.studio',
      url: 'https://www.kommunikations.studio',
      inLanguage: 'de-DE',
      publisher: { '@id': STUDIO },
    },
  ],
}
---
<!doctype html>
<html lang="de" data-ton={ton}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    {!freigegeben && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kommunikations.studio" />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wahrnehmung gestalten. Vom Eindruck zur Wirkung." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={ton === "hell" ? "#ffffff" : "#000000"} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={klasse}>
    <slot />
  </body>
</html>
